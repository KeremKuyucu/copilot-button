// app.rc – Kaynak dosyası: manifest + sürüm bilgisi (Simge olmadan)
// windres veya rc.exe ile derlenir

#include <windows.h>

// ID 1 = RT_MANIFEST
1 RT_MANIFEST "app.manifest"

// ── Sürüm bilgisi ───────────────────────────────────────────────────
VS_VERSION_INFO VERSIONINFO
FILEVERSION     2,1,0,0
PRODUCTVERSION  2,1,0,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"  // Language: English (US) / Unicode
        BEGIN
            VALUE "FileDescription",  "Copilot Button Engine\0"
            VALUE "FileVersion",      "2.1.0.0\0"
            VALUE "ProductName",      "Copilot Button Engine\0"
            VALUE "ProductVersion",   "2.1.0.0\0"
            VALUE "CompanyName",      "Kerem Kuyucu\0"
            VALUE "LegalCopyright",   "Copyright (c) 2026 Kerem Kuyucu\0"
            VALUE "OriginalFilename", "CopilotButtonEngine.exe\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 0x04B0
    END
END
