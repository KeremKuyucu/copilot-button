// app.rc – Kaynak dosyası: manifest + simge + sürüm bilgisi
#include <windows.h>

#define IDI_APP_ICON 101
IDI_APP_ICON ICON "logo.ico"

// ID 1 = RT_MANIFEST
1 RT_MANIFEST "app.manifest"

// ── Sürüm bilgisi ───────────────────────────────────────────────────
VS_VERSION_INFO VERSIONINFO
FILEVERSION     3,1,0,0
PRODUCTVERSION  3,1,0,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"  // Language: English (US) / Unicode
        BEGIN
            VALUE "FileDescription",  "Copilot Button\0"
            VALUE "FileVersion",      "3.1.0.0\0"
            VALUE "ProductName",      "Copilot Button\0"
            VALUE "ProductVersion",   "3.1.0.0\0"
            VALUE "CompanyName",      "Kerem Kuyucu\0"
            VALUE "LegalCopyright",   "Copyright (c) 2026 Kerem Kuyucu\0"
            VALUE "OriginalFilename", "CopilotButton.exe\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 0x04B0
    END
END
